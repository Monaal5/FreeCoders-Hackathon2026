{
  "name": "sunpower-backend",
  "version": "1.0.0",
  "private": true,
  "description": "SunPower solar CRM backend: Lead -> Qualify -> Survey -> Approval -> Quote",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:start": "node --env-file-if-exists=.env scripts/pg-local.mjs",
    "db:reset": "node --env-file-if-exists=.env scripts/db-reset.js",
    "hash": "node scripts/hash-password.js",
    "test:smoke": "node scripts/smoke-test.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "pdfkit": "^0.21.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "embedded-postgres": "^17.10.0-beta.17"
  }
}
