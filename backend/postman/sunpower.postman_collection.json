            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Walk-in Customer\",\n  \"phone\": \"9898989898\",\n  \"city\": \"Indore\",\n  \"source\": \"WHATSAPP\",\n  \"monthlyBill\": 2500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
