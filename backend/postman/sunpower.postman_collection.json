              "raw": "{\n  \"monthlyBill\": 3000,\n  \"roofAreaSqft\": 400,\n  \"sanctionedLoadKw\": 5,\n  \"systemType\": \"ON_GRID\",\n  \"timeline\": \"Within 1 month\",\n  \"notes\": \"Owns the house, decision maker\"\n}"
            }
          }
