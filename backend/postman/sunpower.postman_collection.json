    {
      "name": "5. Orders, Inventory & Dispatch (Phase 2)",
      "description": "Flow: accept a quote (4. Quotes) -> order appears -> pay the advance -> pick list + job -> scan serials -> dispatch -> deliver (warranties start).",
      "item": [
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "header": [],
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/orders?status=PENDING_PAYMENT",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "orders"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "PENDING_PAYMENT"
