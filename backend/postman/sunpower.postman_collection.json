{
  "info": {
    "name": "SunPower – Phase 1 API",
    "description": "Lead -> Qualify -> Survey -> Approval -> Quote. Run \"Auth\" first: the login requests store tokens in collection variables. All demo passwords: password123",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "techToken",
      "value": ""
    },
    {
      "key": "leadId",
      "value": "1"
    },
    {
      "key": "surveyId",
      "value": "1"
    },
    {
      "key": "templateId",
      "value": "3"
    },
    {
      "key": "technicianId",
      "value": "4"
    },
    {
      "key": "quoteId",
      "value": "1"
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Login – staff (sets token)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"staff@sunpower.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('token', j.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login – admin (sets adminToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@sunpower.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('adminToken', j.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login – technician (sets techToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"tech@sunpower.com\",\n  \"password\": \"password123\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('techToken', j.data.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "2. Leads",
      "item": [
        {
          "name": "Public enquiry (no auth)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/public/enquiries",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "public",
                "enquiries"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Neha Gupta\",\n  \"phone\": \"9812345678\",\n  \"email\": \"neha@example.com\",\n  \"address\": \"21 Park Street\",\n  \"city\": \"Lucknow\",\n  \"pincode\": \"226001\",\n  \"propertyType\": \"RESIDENTIAL\",\n  \"monthlyBill\": 3000,\n  \"message\": \"Interested in rooftop solar\"\n}"
            }
          }
        },
        {
          "name": "List leads (filter + search)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leads?status=NEW,QUALIFIED&q=&page=1&limit=20",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ],
              "query": [
                {
                  "key": "status",
                  "value": "NEW,QUALIFIED"
                },
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('leadId', j.data.items[0]?.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create lead manually",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customerName\": \"Walk-in Customer\",\n  \"phone\": \"9898989898\",\n  \"city\": \"Indore\",\n  \"source\": \"WHATSAPP\",\n  \"monthlyBill\": 2500\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('leadId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Lead detail (surveys, quotes, activities)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Qualify lead",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/qualify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "qualify"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"monthlyBill\": 3000,\n  \"roofAreaSqft\": 400,\n  \"sanctionedLoadKw\": 5,\n  \"systemType\": \"ON_GRID\",\n  \"timeline\": \"Within 1 month\",\n  \"notes\": \"Owns the house, decision maker\"\n}"
            }
          }
        },
        {
          "name": "Mark lead lost",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/lost",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "lost"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Budget too low\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "3. Surveys",
      "item": [
        {
          "name": "List technicians",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users?role=TECHNICIAN",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ],
              "query": [
                {
                  "key": "role",
                  "value": "TECHNICIAN"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('technicianId', j.data[0]?.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Assign survey (lead must be QUALIFIED)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/surveys",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "surveys"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"technicianId\": {{technicianId}},\n  \"scheduledDate\": \"2026-12-01\",\n  \"notes\": \"Customer available after 10am\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('surveyId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "My surveys (technician)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/surveys/my",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "surveys",
                "my"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{techToken}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Submit survey with photos (technician)",
          "request": {
            "method": "PATCH",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "surveys",
                "{{surveyId}}",
                "submit"
              ]
            },
            "description": "multipart/form-data. Pick 1-8 image files for \"photos\" (jpg/png/webp/heic, max 5 MB each).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{techToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "roofType",
                  "value": "RCC flat",
                  "type": "text"
                },
                {
                  "key": "roofAreaSqft",
                  "value": "380",
                  "type": "text"
                },
                {
                  "key": "shading",
                  "value": "NONE",
                  "type": "text",
                  "description": "NONE | PARTIAL | HEAVY"
                },
                {
                  "key": "orientation",
                  "value": "South",
                  "type": "text"
                },
                {
                  "key": "sanctionedLoadKw",
                  "value": "5",
                  "type": "text"
                },
                {
                  "key": "recommendedKw",
                  "value": "3",
                  "type": "text"
                },
                {
                  "key": "technicianNotes",
                  "value": "Clear roof, staircase access",
                  "type": "text"
                },
                {
                  "key": "photos",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
        {
          "name": "Review survey – approve (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "surveys",
                "{{surveyId}}",
                "review"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE\",\n  \"note\": \"Looks good\"\n}"
            }
          }
        },
        {
          "name": "Review survey – reject (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "surveys",
                "{{surveyId}}",
                "review"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECT\",\n  \"note\": \"Need a clear photo of the meter\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "4. Quotes",
      "item": [
        {
          "name": "List packages (Panel Set / On-Grid / Off-Grid / Installation)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/templates?kind=ON_GRID",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "templates"
              ],
              "query": [
                {
                  "key": "kind",
                  "value": "ON_GRID"
                }
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('templateId', j.data[0]?.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create quote from package (+ installation)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/leads/{{leadId}}/quotes",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "leads",
                "{{leadId}}",
                "quotes"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"templateId\": {{templateId}},\n  \"includeInstallation\": true,\n  \"discountPct\": 5,\n  \"validDays\": 15,\n  \"notes\": \"Includes subsidy paperwork support\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json(); if (j.success) pm.collectionVariables.set('quoteId', j.data.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get quote",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotes/{{quoteId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes",
                "{{quoteId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Quote PDF",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/quotes/{{quoteId}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes",
                "{{quoteId}}",
                "pdf"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Mark quote SENT",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotes/{{quoteId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes",
                "{{quoteId}}",
                "status"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"SENT\"\n}"
            }
          }
        },
        {
          "name": "Mark quote ACCEPTED (lead -> WON)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/quotes/{{quoteId}}/status",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "quotes",
                "{{quoteId}}",
                "status"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{token}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"ACCEPTED\"\n}"
            }
          }
        }
      ]
    }
  ]
}