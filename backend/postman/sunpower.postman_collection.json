            "header": [],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "surveys",
                "{{surveyId}}",
                "submit"
              ]
            },
            "description": "multipart/form-data. Pick 1-8 image files for \"photos\" (jpg/png/webp/heic, max 5 MB each).",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{techToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "roofType",
                  "value": "RCC flat",
                  "type": "text"
                },
                {
                  "key": "roofAreaSqft",
                  "value": "380",
                  "type": "text"
                },
                {
                  "key": "shading",
                  "value": "NONE",
                  "type": "text",
                  "description": "NONE | PARTIAL | HEAVY"
                },
                {
                  "key": "orientation",
                  "value": "South",
                  "type": "text"
                },
                {
                  "key": "sanctionedLoadKw",
                  "value": "5",
                  "type": "text"
                },
                {
                  "key": "recommendedKw",
                  "value": "3",
                  "type": "text"
                },
                {
                  "key": "technicianNotes",
                  "value": "Clear roof, staircase access",
                  "type": "text"
                },
                {
                  "key": "photos",
                  "type": "file",
                  "src": []
                }
              ]
            }
          }
        },
