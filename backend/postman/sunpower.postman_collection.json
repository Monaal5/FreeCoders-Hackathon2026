              ],
              "path": [
                "surveys",
                "{{surveyId}}",
                "review"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"APPROVE\",\n  \"note\": \"Looks good\"\n}"
            }
          }
        },
        {
          "name": "Review survey – reject (admin)",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/surveys/{{surveyId}}/review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "surveys",
                "{{surveyId}}",
                "review"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"REJECT\",\n  \"note\": \"Need a clear photo of the meter\"\n}"
            }
          }
        }
      ]
