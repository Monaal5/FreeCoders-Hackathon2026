PORT=5000
NODE_ENV=development

# Local PostgreSQL started by `npm run db:start` (port 5433 so it never clashes with a system install)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/sunpower
PG_PORT=5433
# PG_DATA_DIR=   (optional; default %LOCALAPPDATA%\sunpower\pgdata)

JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h

# Vite dev server (comma-separate several)
CORS_ORIGIN=http://localhost:5173
